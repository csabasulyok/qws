{
  "name": "qws-node",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "description": "Safe queueing with auto-reconnect for WebSockets",
  "author": "Csaba Sulyok <csaba.sulyok@gmail.com>",
  "license": "ISC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csabasulyok/qws.git"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json",
    "cb": "pnpm clean && pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm lint && pnpm format:check && pnpm build",
    "publish:local": "pnpm publish --loglevel info --registry=http://localhost:8081/repository/npm-releases/",
    "publish:npmjs": "pnpm publish --loglevel info --registry=https://registry.npmjs.org/",
    "example:wsmessage": "tsx examples/wsmessage.ts",
    "example:broadcaster": "tsx examples/broadcaster.ts",
    "example:server": "tsx examples/server.ts",
    "example:listener": "tsx examples/listener.ts"
  },
  "dependencies": {
    "auto-bind": "5.0.1",
    "route-recognizer": "0.3.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unicorn": "78.0.0",
    "npm-check-updates": "23.1.1",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
